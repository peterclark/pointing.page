# Supabase Configuration (Development Environment)
# Copy this file to .env.local and fill in your actual values

# Supabase Project URL
# Obtain from: https://supabase.com/dashboard/project/YOUR_PROJECT_REF/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous/Public Key
# This key is safe to use in the browser and is required for client-side operations
# Obtain from: https://supabase.com/dashboard/project/YOUR_PROJECT_REF/settings/api
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: Never commit .env.local to version control
# The .gitignore file is configured to exclude all *.local files

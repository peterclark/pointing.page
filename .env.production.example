# Supabase Configuration (Production Environment)
# Use these values when deploying to production environment

# Supabase Project URL for Production
# Obtain from: https://supabase.com/dashboard/project/YOUR_PRODUCTION_PROJECT_REF/settings/api
VITE_SUPABASE_URL=https://your-production-project-ref.supabase.co

# Supabase Anonymous/Public Key for Production
# Obtain from: https://supabase.com/dashboard/project/YOUR_PRODUCTION_PROJECT_REF/settings/api
VITE_SUPABASE_ANON_KEY=your-production-anon-key-here

# Configure these values in your production deployment environment (e.g., Netlify)
# Never commit actual production keys to version control


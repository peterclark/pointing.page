# Supabase Configuration (Staging Environment)
# Use these values when deploying to staging environment

# Supabase Project URL for Staging
# Obtain from: https://supabase.com/dashboard/project/YOUR_STAGING_PROJECT_REF/settings/api
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co

# Supabase Anonymous/Public Key for Staging
# Obtain from: https://supabase.com/dashboard/project/YOUR_STAGING_PROJECT_REF/settings/api
VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here

# Configure these values in your staging deployment environment (e.g., Netlify)
# Never commit actual staging keys to version control

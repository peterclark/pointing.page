{
  "name": "shadcn-mcp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "npm run supabase:use-local && vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "generate-types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "supabase:start": "npx supabase@latest start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:use-local": "bash scripts/use-local-supabase.sh",
    "supabase:use-local-fresh": "bash scripts/use-local-supabase.sh --reset",
    "supabase:use-cloud": "bash scripts/use-cloud-supabase.sh",
    "supabase:studio": "npx supabase studio open",
    "supabase:reset": "npx supabase db reset"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.86.2",
    "@tailwindcss/vite": "^4.1.16",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.18.4",
    "simplex-noise": "^4.0.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.2.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.10",
    "shadcn": "^3.5.0",
    "supabase": "^2.54.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
